/* ---------- 5페이지 기본형만의 손질 ---------- */
/* 속장에는 히어로가 없다. 대신 제목 띠가 첫 화면을 받친다. */
.pagehead{
  background:var(--color-surface);
  border-bottom:1px solid var(--color-border);
  padding:calc(var(--section-pad) * .5) 0;
}
.pagehead__crumb{color:var(--color-text-muted);font-size:.875rem;margin-bottom:.8em}
.pagehead__crumb a:hover{color:var(--color-primary)}
.pagehead__title{font-size:var(--h1)}
.pagehead__sub{margin:.7em 0 0;color:var(--color-text-muted);max-width:60ch}
/* 속장 첫 띠는 제목 띠와 붙으므로 위 여백을 줄인다. */
.pagehead + .band{padding-top:calc(var(--section-pad) * .72)}

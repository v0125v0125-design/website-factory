/* MASTER_INTERIOR_01 — {{ brief.business.name }}
   테마 {{ brief.theme.preset or '(직접 지정)' }} · 스타일 출처 {{ style.source }}

   색·서체·모서리·여백은 전부 아래 토큰에서 나옵니다. 고객이 바뀌면
   토큰만 바뀌고 이 아래 규칙은 그대로입니다. */

:root{
{%- for key, value in tokens | dictsort %}
  --{{ key }}: {{ value }};
{%- endfor %}
  --wrap: min(1240px, 100% - 48px);
  --pad-y: clamp(72px, 8.5vw, 132px);
  --head-h: 76px;
  --ease: cubic-bezier(.22,.7,.28,1);
  --ink: color-mix(in srgb, var(--color-primary) 20%, #131416);
}

*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{
  margin:0;background:var(--color-background);color:var(--color-text);
  font-family:var(--font-body);font-size:var(--text-base);line-height:1.75;
  letter-spacing:-.012em;word-break:keep-all;overflow-wrap:break-word;
  overflow-x:hidden;
}
img{display:block;max-width:100%;height:auto}
a{color:inherit;text-decoration:none}
h1,h2,h3,h4{font-family:var(--font-heading);margin:0;line-height:1.24;letter-spacing:-.032em;font-weight:700}
p{margin:0 0 1em}
ul,ol,dl,dd{margin:0;padding:0;list-style:none}
:focus-visible{outline:3px solid var(--color-accent);outline-offset:3px}
[id]{scroll-margin-top:calc(var(--head-h) + 16px)}

.wrap{width:var(--wrap);margin-inline:auto}
.sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.skip{position:absolute;left:-9999px;top:0;z-index:100;background:var(--color-primary);color:var(--color-on-primary);padding:12px 18px}
.skip:focus{left:8px;top:8px}

/* ── 섹션 공통 ─────────────────────────────────────────────── */
.sec{padding:var(--pad-y) 0}
.sec--tint{background:var(--color-surface)}
.sec__head{max-width:56ch;margin-bottom:clamp(32px,4vw,56px)}
.sec__head--center{margin-inline:auto;text-align:center}
.eyebrow{
  margin:0 0 14px;font-family:var(--font-heading);font-weight:700;
  font-size:.75rem;letter-spacing:.2em;text-transform:uppercase;color:var(--color-accent);
}
.h2{font-size:clamp(1.65rem,1.05rem + 2.1vw, 2.5rem)}
.h3{font-size:clamp(1.05rem,.95rem + .5vw,1.3rem)}
.lead{margin:.9em 0 0;color:var(--color-text-muted);font-size:1.0625rem}
.muted{color:var(--color-text-muted)}

/* ── 버튼 ──────────────────────────────────────────────────── */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:.45em;
  padding:15px 30px;border:1px solid transparent;border-radius:var(--radius);
  background:var(--color-primary);color:var(--color-on-primary);
  font-family:var(--font-heading);font-weight:700;font-size:1rem;line-height:1.2;
  cursor:pointer;transition:background .2s var(--ease),transform .2s var(--ease),border-color .2s;
}
.btn:hover{background:var(--color-primary-hover);transform:translateY(-1px)}
.btn--line{background:transparent;color:var(--color-primary);border-color:var(--color-border)}
.btn--line:hover{background:var(--color-surface);border-color:var(--color-primary)}
.btn--ghost{background:rgba(255,255,255,.10);color:#fff;border-color:rgba(255,255,255,.55);backdrop-filter:blur(4px)}
.btn--ghost:hover{background:rgba(255,255,255,.22);color:#fff}
.btn--light{background:var(--color-background);color:var(--color-primary)}
.btn--light:hover{background:var(--color-surface)}
.btn--sm{padding:11px 20px;font-size:.9375rem}
.btn--block{width:100%}

/* ── 머리 ──────────────────────────────────────────────────── */
.mh{
  position:fixed;inset:0 0 auto;z-index:60;
  background:var(--color-background);border-bottom:1px solid var(--color-border);
  transition:background .25s var(--ease),border-color .25s var(--ease);
}
.mh__inner{display:flex;align-items:center;gap:clamp(16px,2.4vw,36px);height:var(--head-h)}
.mh__brand{display:flex;align-items:center;gap:10px;font-family:var(--font-heading);font-weight:700;font-size:1.0625rem;letter-spacing:-.03em;flex:none}
.mh__mark{width:34px;height:34px;flex:none;display:grid;place-items:center;border-radius:var(--radius-sm);background:var(--color-primary);color:var(--color-on-primary);font-size:.95rem}
.mh__mark img{width:100%;height:100%;object-fit:contain;border-radius:inherit}
.mh__nav{margin-left:auto}
.mh__list{display:flex;align-items:center;gap:clamp(14px,1.9vw,30px);font-size:.9375rem;font-weight:500}
.mh__list a{color:var(--color-text-muted);transition:color .18s}
.mh__item--more{display:none}   /* 좁은 화면 메뉴에서만 펼친다 */
.mh__list a:hover{color:var(--color-primary)}
.mh__aside{display:flex;align-items:center;gap:12px;flex:none}
.mh__tel{font-family:var(--font-heading);font-weight:700;font-size:1.0625rem;letter-spacing:-.02em;white-space:nowrap}
.mh__toggle{display:none;width:44px;height:44px;margin-left:auto;background:none;border:0;color:inherit;cursor:pointer}
.mh__toggle span{display:block;width:22px;height:2px;margin:5px auto;background:currentColor;transition:transform .25s var(--ease),opacity .2s}
.mh.is-open .mh__toggle span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.mh.is-open .mh__toggle span:nth-child(2){opacity:0}
.mh.is-open .mh__toggle span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

/* 첫 화면 위에서는 투명하게 뜬다. 자바스크립트가 없으면 흰 머리 그대로 — 언제나 읽힌다. */
.mh--ghost{background:transparent;border-color:transparent;color:#fff}
.mh--ghost .mh__list a,.mh--ghost .mh__tel{color:rgba(255,255,255,.88)}
.mh--ghost .mh__list a:hover{color:#fff}
.mh--ghost .mh__mark{background:rgba(255,255,255,.16);color:#fff;backdrop-filter:blur(4px)}
.mh--ghost .btn--line{color:#fff;border-color:rgba(255,255,255,.5)}
.mh--ghost .btn--line:hover{background:rgba(255,255,255,.16)}

/* ── 첫 화면 ───────────────────────────────────────────────── */
.hero{
  position:relative;display:flex;align-items:flex-end;overflow:hidden;
  min-height:min(92vh,820px);
  padding:calc(var(--head-h) + 80px) 0 clamp(72px,8vw,120px);
  color:#fff;
}
.hero__bg{position:absolute;inset:0;background:linear-gradient(130deg,var(--color-primary),var(--ink));background-size:cover;background-position:center}
.hero__bg::after{
  content:"";position:absolute;inset:0;
  background:
    linear-gradient(94deg, rgba(0,0,0,.74) 0%, rgba(0,0,0,.58) 42%, rgba(0,0,0,.22) 100%),
    linear-gradient(0deg, rgba(0,0,0,.55) 0%, rgba(0,0,0,0) 55%);
}
.hero__slot{
  position:absolute;top:calc(var(--head-h) + 24px);right:24px;z-index:2;
  padding:10px 16px;border:1px dashed rgba(255,255,255,.6);border-radius:var(--radius-sm);
  background:rgba(0,0,0,.3);font-size:.875rem;
}
.hero__inner{position:relative;z-index:2;max-width:46rem}
.hero__kicker{margin:0 0 18px;font-family:var(--font-heading);font-weight:700;font-size:.875rem;letter-spacing:.06em;color:rgba(255,255,255,.84)}
.hero__title{font-size:clamp(2.05rem,1.15rem + 3.5vw,3.6rem);line-height:1.16;letter-spacing:-.04em;font-weight:800;text-shadow:0 2px 24px rgba(0,0,0,.35)}
.hero__sub{margin:1em 0 0;max-width:38ch;font-size:clamp(1rem,.95rem + .3vw,1.1875rem);color:rgba(255,255,255,.92)}
.hero__actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:2em}
.hero__badges{display:flex;flex-wrap:wrap;gap:8px;margin-top:2.2em}
.hero__badges li{padding:7px 14px;border:1px solid rgba(255,255,255,.4);border-radius:var(--radius-pill);font-size:.875rem;color:rgba(255,255,255,.92);backdrop-filter:blur(3px)}

/* ── 강점 띠 (첫 화면에 살짝 물린다) ───────────────────────── */
.strip{position:relative;z-index:5;margin-top:clamp(-88px,-6vw,-48px)}
.strip__card{
  display:grid;grid-template-columns:repeat(var(--cols,4),minmax(0,1fr));
  background:var(--color-background);border:1px solid var(--color-border);
  border-radius:var(--radius-lg);box-shadow:var(--shadow);overflow:hidden;
}
.strip__item{padding:clamp(24px,2.6vw,36px) clamp(20px,2vw,30px);border-left:1px solid var(--color-border)}
.strip__item:first-child{border-left:0}
.strip__num{display:flex;align-items:baseline;gap:4px;font-family:var(--font-heading);font-weight:800;font-size:clamp(1.7rem,1.1rem + 1.5vw,2.4rem);color:var(--color-primary);letter-spacing:-.04em;line-height:1.1}
.strip__unit{font-size:.9375rem;font-weight:700;color:var(--color-accent)}
.strip__title{margin:.55em 0 0;font-size:1.0625rem}
.strip__text{margin:.4em 0 0;font-size:.9375rem;color:var(--color-text-muted)}
.strip + .sec{padding-top:clamp(64px,7vw,104px)}

/* ── 서비스 ────────────────────────────────────────────────── */
.svc{display:grid;grid-template-columns:repeat(var(--cols,3),minmax(0,1fr));gap:clamp(18px,2.2vw,30px)}
.svc__card{display:flex;flex-direction:column;background:var(--color-background);border:1px solid var(--color-border);border-radius:var(--radius);overflow:hidden;transition:transform .25s var(--ease),box-shadow .25s var(--ease)}
.svc__card:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
.svc__figure{position:relative;aspect-ratio:4/3;background:var(--color-surface);overflow:hidden}
.svc__figure img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .5s var(--ease)}
.svc__card:hover .svc__figure img{transform:scale(1.04)}
.svc__slot{position:absolute;inset:0;display:grid;place-items:center;color:var(--color-text-muted);font-size:.875rem;background:repeating-linear-gradient(45deg,var(--color-surface),var(--color-surface) 12px,var(--color-background) 12px,var(--color-background) 24px)}
.svc__body{padding:clamp(22px,2.2vw,30px);display:flex;flex-direction:column;gap:.55em;flex:1}
.svc__price{margin-top:auto;padding-top:.6em;font-family:var(--font-heading);font-weight:700;color:var(--color-primary)}
.svc__bullets{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:.3em;font-size:.9375rem;color:var(--color-text-muted)}
.svc__bullets li{position:relative;padding-left:12px}
.svc__bullets li::before{content:"";position:absolute;left:0;top:.66em;width:5px;height:5px;border-radius:50%;background:var(--color-accent)}

/* ── 소개 ──────────────────────────────────────────────────── */
.about{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1fr);gap:clamp(32px,4.5vw,72px);align-items:center}
.about__figure{position:relative;aspect-ratio:3/4;border-radius:var(--radius);overflow:hidden;background:var(--color-surface)}
.about__figure img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.about__text p{max-width:60ch;color:var(--color-text-muted);font-size:1.0625rem}
.about__text p:first-of-type{color:var(--color-text);font-size:clamp(1.05rem,1rem + .4vw,1.25rem);line-height:1.7}
.about__facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:22px;margin-top:32px;padding-top:28px;border-top:1px solid var(--color-border)}
.about__facts dt{font-size:.8125rem;letter-spacing:.06em;color:var(--color-text-muted);margin-bottom:.35em}
.about__facts dd{font-family:var(--font-heading);font-weight:700}
.about__sign{margin-top:28px;font-family:var(--font-heading);font-weight:700;color:var(--color-primary)}

/* ── 시공 사례 ─────────────────────────────────────────────── */
.pj__top{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:20px}
.pj__chips{display:flex;flex-wrap:wrap;gap:8px}
.pj__chip{padding:9px 18px;border:1px solid var(--color-border);border-radius:var(--radius-pill);background:var(--color-background);color:var(--color-text-muted);font-size:.9375rem;font-weight:500;cursor:pointer;transition:.18s}
.pj__chip:hover{border-color:var(--color-primary);color:var(--color-primary)}
.pj__chip[aria-pressed="true"]{background:var(--color-primary);border-color:var(--color-primary);color:var(--color-on-primary)}
.pj__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(12px,1.5vw,20px);margin-top:clamp(28px,3vw,44px)}
.pj__cell{position:relative;aspect-ratio:4/3;margin:0;border-radius:var(--radius);overflow:hidden;background:var(--color-surface)}
.pj__cell:first-child{grid-column:span 2;grid-row:span 2;aspect-ratio:auto}
.pj__open{position:absolute;inset:0;width:100%;height:100%;padding:0;border:0;background:none;cursor:pointer;text-align:left;color:#fff}
.pj__open img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .6s var(--ease)}
.pj__open:hover img{transform:scale(1.05)}
.pj__veil{position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.78) 0%,rgba(0,0,0,.25) 42%,rgba(0,0,0,0) 72%)}
.pj__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(18px,2vw,28px);display:block}
.pj__name{display:block;font-size:clamp(1rem,.94rem + .4vw,1.3rem);text-shadow:0 1px 14px rgba(0,0,0,.4)}
.pj__meta{display:block;margin:.45em 0 0;font-size:.875rem;color:rgba(255,255,255,.86)}
.pj__count{position:absolute;top:14px;right:14px;padding:5px 11px;border-radius:var(--radius-pill);background:rgba(0,0,0,.55);font-size:.8125rem;backdrop-filter:blur(3px)}
.pj__slot{position:absolute;inset:0;display:grid;place-items:center;color:var(--color-text-muted);font-size:.875rem}
.pj__more{margin-top:28px;text-align:center}

/* 크게 보기 */
.lb{position:fixed;inset:0;z-index:90;display:none;background:rgba(10,10,11,.94);padding:24px}
.lb.is-open{display:flex;flex-direction:column}
.lb__bar{display:flex;align-items:center;justify-content:space-between;gap:16px;color:#fff;padding-bottom:16px}
.lb__title{font-family:var(--font-heading);font-weight:700;font-size:1.0625rem}
.lb__meta{font-size:.875rem;color:rgba(255,255,255,.7)}
.lb__close,.lb__nav{background:rgba(255,255,255,.12);border:0;color:#fff;width:46px;height:46px;border-radius:50%;font-size:1.25rem;cursor:pointer}
.lb__close:hover,.lb__nav:hover{background:rgba(255,255,255,.26)}
.lb__stage{position:relative;flex:1;display:grid;place-items:center;min-height:0}
.lb__stage img{max-width:100%;max-height:100%;object-fit:contain;border-radius:var(--radius-sm)}
.lb__nav{position:absolute;top:50%;transform:translateY(-50%)}
.lb__nav--prev{left:0}
.lb__nav--next{right:0}
.lb__foot{padding-top:14px;text-align:center;color:rgba(255,255,255,.7);font-size:.875rem}

/* ── 절차 ──────────────────────────────────────────────────── */
.steps{display:grid;grid-template-columns:repeat(var(--cols,4),minmax(0,1fr));gap:clamp(18px,2.4vw,32px)}
.step{padding-top:26px;border-top:2px solid var(--color-border);position:relative}
.step::before{content:"";position:absolute;top:-5px;left:0;width:8px;height:8px;border-radius:50%;background:var(--color-accent)}
.step__no{font-family:var(--font-heading);font-weight:800;font-size:.875rem;letter-spacing:.14em;color:var(--color-accent)}
.step__title{margin:.5em 0 0;font-size:1.0625rem}
.step__text{margin:.5em 0 0;font-size:.9375rem;color:var(--color-text-muted)}
.step__time{display:inline-block;margin-top:.9em;padding:4px 12px;border-radius:var(--radius-pill);background:var(--color-surface);border:1px solid var(--color-border);font-size:.8125rem;color:var(--color-text-muted)}
.sec--tint .step__time{background:var(--color-background)}

/* ── 후기 ──────────────────────────────────────────────────── */
.reviews{display:grid;grid-template-columns:repeat(var(--cols,3),minmax(0,1fr));gap:clamp(18px,2.2vw,30px)}
.review{background:var(--color-background);border:1px solid var(--color-border);border-radius:var(--radius);padding:clamp(24px,2.4vw,34px);display:flex;flex-direction:column}
.review__stars{color:var(--color-accent);letter-spacing:.14em;font-size:.9375rem;margin-bottom:.9em}
.review__quote{margin:0;font-size:1.0625rem;line-height:1.72}
.review__by{margin:1.4em 0 0;padding-top:1em;border-top:1px solid var(--color-border);font-size:.9375rem;color:var(--color-text-muted)}
.review__who{font-family:var(--font-heading);font-weight:700;color:var(--color-text)}

/* ── 자주 묻는 질문 ────────────────────────────────────────── */
.faq{max-width:880px;margin-inline:auto}
.faq__row{border-bottom:1px solid var(--color-border)}
.faq__row summary{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:22px 0;cursor:pointer;list-style:none;font-family:var(--font-heading);font-weight:700;font-size:1.0625rem}
.faq__row summary::-webkit-details-marker{display:none}
.faq__row summary::after{content:"+";flex:none;font-size:1.4rem;font-weight:400;color:var(--color-accent);transition:transform .2s}
.faq__row[open] summary::after{content:"−"}
.faq__row p{margin:0;padding:0 0 24px;max-width:70ch;color:var(--color-text-muted)}

/* ── 중간 유도 띠 ──────────────────────────────────────────── */
.band{background:var(--color-primary);color:var(--color-on-primary);padding:clamp(48px,6vw,84px) 0}
.band__inner{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:28px}
.band__title{font-size:clamp(1.4rem,1rem + 1.4vw,2rem);max-width:24ch}
.band__text{margin:.6em 0 0;opacity:.82}
.band__actions{display:flex;flex-wrap:wrap;gap:12px}
.band .btn--line{color:var(--color-on-primary);border-color:color-mix(in srgb,var(--color-on-primary) 45%,transparent)}
.band .btn--line:hover{background:color-mix(in srgb,var(--color-on-primary) 14%,transparent)}

/* ── 문의 ──────────────────────────────────────────────────── */
.ct{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.9fr);gap:clamp(28px,4vw,64px);align-items:start}
.ct__form{background:var(--color-background);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:clamp(26px,3vw,40px);box-shadow:var(--shadow)}
.field{margin:0 0 18px}
.field label{display:block;font-size:.875rem;font-weight:500;color:var(--color-text-muted);margin-bottom:7px}
.field input,.field textarea,.field select{
  width:100%;padding:13px 15px;font:inherit;font-size:1rem;color:var(--color-text);
  background:var(--color-background);border:1px solid var(--color-border);border-radius:var(--radius-sm);
}
.field textarea{resize:vertical;min-height:120px}
.field input:focus,.field textarea:focus,.field select:focus{border-color:var(--color-primary);outline:none;box-shadow:0 0 0 3px color-mix(in srgb,var(--color-primary) 20%,transparent)}
.field--row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.field--check{display:flex;gap:10px;align-items:flex-start}
.field--check input{width:auto;margin-top:.4em}
.field--check label{margin:0;font-size:.875rem}
.ct__note{margin:1em 0 0;font-size:.8125rem;color:var(--color-text-muted)}
.ct__list{display:grid;gap:22px}
.ct__row{display:grid;gap:4px;padding-bottom:20px;border-bottom:1px solid var(--color-border)}
.ct__label{font-size:.8125rem;letter-spacing:.06em;color:var(--color-text-muted)}
.ct__value{font-family:var(--font-heading);font-weight:700;font-size:1.0625rem;word-break:break-all}
.ct__actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:4px}

/* ── 바닥 ──────────────────────────────────────────────────── */
.mf{background:var(--ink);color:rgba(255,255,255,.72);padding:clamp(48px,5vw,72px) 0 40px;font-size:.9375rem}
body.theme-dark .mf{background:var(--color-surface);border-top:1px solid var(--color-border);color:var(--color-text-muted)}
.mf__grid{display:grid;grid-template-columns:minmax(0,1.3fr) repeat(2,minmax(0,1fr));gap:clamp(28px,3vw,48px)}
.mf__name{font-family:var(--font-heading);font-weight:700;font-size:1.125rem;color:#fff;margin-bottom:.8em}
body.theme-dark .mf__name{color:var(--color-text)}
.mf h4{font-size:.8125rem;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.5);margin-bottom:1em}
body.theme-dark .mf h4{color:var(--color-text-muted)}
.mf a:hover{color:#fff;text-decoration:underline}
.mf__links{display:grid;gap:.6em}
.mf__bottom{margin-top:clamp(32px,4vw,52px);padding-top:24px;border-top:1px solid rgba(255,255,255,.14);display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;font-size:.8125rem;color:rgba(255,255,255,.55)}
body.theme-dark .mf__bottom{border-top-color:var(--color-border);color:var(--color-text-muted)}

/* ── 모바일 하단 바 ────────────────────────────────────────── */
.mbar{
  position:fixed;left:0;right:0;bottom:0;z-index:70;display:none;
  grid-template-columns:repeat(var(--n,3),minmax(0,1fr));
  background:var(--color-background);border-top:1px solid var(--color-border);
  padding-bottom:env(safe-area-inset-bottom,0);
  box-shadow:0 -6px 22px rgba(0,0,0,.10);
}
.mbar a{display:flex;align-items:center;justify-content:center;gap:.35em;padding:16px 6px;font-family:var(--font-heading);font-weight:700;font-size:.9375rem;color:var(--color-text)}
.mbar a + a{border-left:1px solid var(--color-border)}
.mbar .is-primary{background:var(--color-primary);color:var(--color-on-primary)}

/* ── 화면 크기 ─────────────────────────────────────────────── */
@media (max-width:1100px){
  .strip__card{grid-template-columns:repeat(2,minmax(0,1fr))}
  .strip__item:nth-child(3),.strip__item:nth-child(4){border-top:1px solid var(--color-border)}
  .strip__item:nth-child(odd){border-left:0}
  .svc,.reviews,.steps{grid-template-columns:repeat(2,minmax(0,1fr))}
  .pj__grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .pj__cell:first-child{grid-column:span 2;grid-row:span 1;aspect-ratio:16/9}
}
@media (max-width:860px){
  :root{--wrap:min(100% - 36px, 720px)}
  .mh__toggle{display:block}
  .mh__aside{display:none}
  .mh__nav{position:fixed;inset:var(--head-h) 0 auto;margin:0;background:var(--color-background);border-bottom:1px solid var(--color-border);transform:translateY(-120%);transition:transform .3s var(--ease);max-height:calc(100dvh - var(--head-h));overflow:auto}
  .mh.is-open .mh__nav{transform:translateY(0)}
  .mh.is-open{background:var(--color-background);border-bottom-color:var(--color-border);color:var(--color-text)}
  .mh.is-open .mh__mark{background:var(--color-primary);color:var(--color-on-primary)}
  .mh__list{flex-direction:column;align-items:stretch;gap:0;padding:8px 24px 20px}
  .mh__list li{border-bottom:1px solid var(--color-border)}
  .mh__list a{display:block;padding:15px 0;font-size:1.0625rem;color:var(--color-text)}
  .mh__item--more{display:block}
  .hero{min-height:min(88vh,700px);padding-top:calc(var(--head-h) + 56px)}
  .about{grid-template-columns:1fr}
  .about__figure{aspect-ratio:16/11;order:-1}
  .ct{grid-template-columns:1fr}
  .mf__grid{grid-template-columns:1fr 1fr}
  .mbar{display:grid}
  body{padding-bottom:64px}
  .band__inner{display:block}
  .band__actions{margin-top:24px}
}
@media (max-width:560px){
  .svc,.reviews,.steps,.strip__card,.pj__grid{grid-template-columns:1fr}
  .strip{margin-top:-40px}
  .strip__item{border-left:0;border-top:1px solid var(--color-border)}
  .strip__item:first-child{border-top:0}
  .pj__cell,.pj__cell:first-child{grid-column:span 1;grid-row:span 1;aspect-ratio:4/3}
  .field--row{grid-template-columns:1fr}
  .mf__grid{grid-template-columns:1fr}
  .hero__actions .btn{flex:1 1 auto}
}
@media (prefers-reduced-motion:reduce){
  *{animation-duration:.01ms !important;transition-duration:.01ms !important;scroll-behavior:auto !important}
  .svc__card:hover,.btn:hover{transform:none}
  .pj__open:hover img,.svc__card:hover .svc__figure img{transform:none}
}
